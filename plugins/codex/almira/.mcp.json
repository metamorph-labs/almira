{
  "mcpServers": {
    "almira": {
      "command": "npx",
      "args": [
        "--yes",
        "@metamorph-labs/almira-mcp@0.1.0-dev.59"
      ],
      "env_vars": [
        "ALMIRA_BASE_URL",
        "METAMORPH_TOKEN"
      ]
    },
    "metamorph": {
      "command": "npx",
      "args": [
        "--yes",
        "@metamorph-labs/metamorph-tools@0.1.0-dev.0"
      ],
      "env_vars": [
        "METAMORPH_BASE_URL"
      ]
    }
  }
}
