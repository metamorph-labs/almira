{
  "schema_id": "almira.public.configuration-conformance-vectors.v1",
  "format_version": 1,
  "vectors": [
    {
      "name": "managed_development_configuration",
      "instance": {
        "api_version": "almira/v1",
        "environments": [
          {
            "key": "development",
            "display_name": "Development",
            "browser_origins": [
              "http://localhost:3000"
            ],
            "collections": [
              {
                "key": "assets",
                "display_name": "Assets",
                "malware_scan_required": true,
                "storage_class": "normal",
                "recycle_retention_days": 90
              }
            ]
          }
        ]
      },
      "expected": "valid"
    },
    {
      "name": "normal_class_defaults_when_omitted",
      "instance": {
        "api_version": "almira/v1",
        "environments": [
          {
            "key": "preview-one",
            "display_name": "Preview one",
            "collections": [
              {
                "key": "sessions",
                "display_name": "Sessions",
                "malware_scan_required": false
              }
            ]
          }
        ]
      },
      "expected": "valid"
    },
    {
      "name": "collection_vector_search_is_explicit",
      "instance": {
        "api_version": "almira/v1",
        "environments": [
          {
            "key": "development",
            "display_name": "Development",
            "collections": [
              {
                "key": "documents",
                "display_name": "Documents",
                "malware_scan_required": true,
                "extraction": {
                  "content": true,
                  "ocr": true,
                  "transcription": false,
                  "vector_indexing": true
                }
              }
            ]
          }
        ]
      },
      "expected": "valid"
    },
    {
      "name": "collection_media_processing_is_explicit_and_bounded",
      "instance": {
        "api_version": "almira/v1",
        "environments": [
          {
            "key": "development",
            "display_name": "Development",
            "collections": [
              {
                "key": "media",
                "display_name": "Media",
                "malware_scan_required": true,
                "media": {
                  "image_presets": {
                    "thumbnail": {
                      "widths": [
                        256,
                        512
                      ],
                      "height": 256,
                      "fit": "cover",
                      "formats": [
                        "avif",
                        "webp"
                      ],
                      "without_enlargement": true
                    }
                  },
                  "document_previews": true,
                  "video_profile": "web_hls_v1"
                }
              }
            ]
          }
        ]
      },
      "expected": "valid"
    },
    {
      "name": "vector_search_without_content_is_refused",
      "instance": {
        "api_version": "almira/v1",
        "environments": [
          {
            "key": "development",
            "display_name": "Development",
            "collections": [
              {
                "key": "documents",
                "display_name": "Documents",
                "malware_scan_required": true,
                "extraction": {
                  "content": false,
                  "ocr": false,
                  "transcription": false,
                  "vector_indexing": true
                }
              }
            ]
          }
        ]
      },
      "expected": "invalid"
