    {
      "name": "recycle_retention_must_be_bounded",
      "instance": {
        "api_version": "almira/v1",
        "environments": [
          {
            "key": "development",
            "display_name": "Development",
            "collections": [
              {
                "key": "assets",
                "display_name": "Assets",
                "malware_scan_required": true,
                "recycle_retention_days": 0
              }
            ]
          }
        ]
      },
      "expected": "invalid"
    },
    {
      "name": "provider_coordinates_are_refused",
      "instance": {
        "api_version": "almira/v1",
        "environments": [],
