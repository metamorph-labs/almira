  "error_vectors": [
    {
      "name": "cross_project_is_forbidden",
      "condition": "authenticated scope does not equal the requested project",
      "code": "ALMIRA_FILE_SCOPE_MISMATCH",
      "http_status": 403
    },
    {
      "name": "expired_transfer_is_gone",
      "condition": "finalization occurs after the durable transfer expiry",
      "code": "ALMIRA_FILE_TRANSFER_EXPIRED",
      "http_status": 410
    },
    {
      "name": "required_scan_blocks_read",
      "condition": "the current generation safety state is scan_pending or blocked",
      "code": "ALMIRA_FILE_NOT_AVAILABLE",
      "http_status": 404
    },
    {
      "name": "changed_idempotent_input_conflicts",
      "condition": "an operation id is replayed with a different request digest",
      "code": "ALMIRA_FILE_OPERATION_CONFLICT",
      "http_status": 409
    },
    {
      "name": "ambiguous_fileservice_effect_is_retryable",
      "condition": "the FileService result cannot be determined safely",
      "code": "ALMIRA_FILE_OUTCOME_UNKNOWN",
      "http_status": 503
    },
    {
      "name": "missing_collection_is_not_found",
      "condition": "the exact active collection instance does not exist in the authorized environment",
      "code": "ALMIRA_COLLECTION_NOT_FOUND",
      "http_status": 404
    },
    {
      "name": "system_environment_deletion_is_refused",
      "condition": "deletion targets the managed development or production environment",
      "code": "ALMIRA_ENVIRONMENT_SYSTEM_PROTECTED",
      "http_status": 409
    },
    {
      "name": "invalid_storage_owner_catalog_is_retryable",
      "condition": "FileService returns stale, malformed, scope-mismatched, coordinate-bearing, or provider-matrix-drifted capability evidence",
      "code": "ALMIRA_STORAGE_INTEGRITY_FAILURE",
      "http_status": 503
    },
    {
      "name": "active_transfer_blocks_storage_migration",
      "condition": "the collection has a prepared, uploading, finalizing, or ambiguous transfer",
      "code": "ALMIRA_STORAGE_MIGRATION_ACTIVE_TRANSFER",
      "http_status": 409
    },
    {
      "name": "ambiguous_storage_migration_start_is_retryable",
      "condition": "FileService may have accepted the migration but its response was not received",
      "code": "ALMIRA_STORAGE_MIGRATION_OUTCOME_UNKNOWN",
      "http_status": 503
    }
  ]
}
