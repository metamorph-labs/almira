            "type": "integer",
            "minimum": 1,
            "maximum": 10737418240
          },
          "content_sha256": {
            "$ref": "#/components/schemas/ContentSha256"
          },
          "one_use": {
            "const": true
          },
          "expires_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        }
