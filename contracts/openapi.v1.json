            "type": "integer",
            "minimum": 1
          },
          "origins": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/BrowserOrigin"
            }
          }
        }
      },
      "BrowserOriginPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "environment_id",
          "origins",
          "revision"
        ],
        "properties": {
          "environment_id": {
            "$ref": "#/components/schemas/UuidV7"
          },
          "origins": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/BrowserOrigin"
            }
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ReplaceBrowserOriginsOutcome": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "disposition",
          "policy"
        ],
        "properties": {
          "disposition": {
            "type": "string",
            "enum": [
              "applied",
              "exact_replay"
            ]
          },
          "policy": {
            "$ref": "#/components/schemas/BrowserOriginPolicy"
          }
        }
      },
      "CreateCollectionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collection_key",
          "display_name",
          "malware_scan_required"
        ],
        "properties": {
          "collection_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z]([a-z0-9_-]{0,62}[a-z0-9])?$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "malware_scan_required": {
            "type": "boolean"
          }
        }
      },
      "Collection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collection_id",
          "collection_instance_id",
          "environment_id",
          "collection_key",
          "display_name",
          "access_template",
          "storage_class",
          "storage_binding_state",
          "technical_metadata_extraction",
          "malware_scan_required",
          "content_extraction",
          "vector_indexing",
          "delivery_mode",
          "revision",
          "created_at"
        ],
        "properties": {
          "collection_id": {
            "$ref": "#/components/schemas/UuidV7"
          },
          "collection_instance_id": {
            "$ref": "#/components/schemas/UuidV7"
          },
          "environment_id": {
            "$ref": "#/components/schemas/UuidV7"
          },
          "collection_key": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "access_template": {
            "const": "private"
          },
          "storage_class": {
            "const": "normal"
          },
          "storage_binding_state": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "migrating",
              "failed"
            ]
          },
          "technical_metadata_extraction": {
            "const": true
          },
          "malware_scan_required": {
            "type": "boolean"
          },
          "content_extraction": {
            "const": false
          },
          "vector_indexing": {
            "const": false
          },
          "delivery_mode": {
            "const": "off"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "$ref": "#/components/schemas/Timestamp"
          }
        }
      },
      "CreateCollectionOutcome": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "disposition",
          "collection"
        ],
        "properties": {
          "disposition": {
            "type": "string",
            "enum": [
              "applied",
              "exact_replay"
            ]
          },
          "collection": {
            "$ref": "#/components/schemas/Collection"
          }
        }
      },
      "CollectionPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collections",
          "next_cursor"
        ],
        "properties": {
          "collections": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Collection"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          }
        }
      },
      "LogicalPath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?![.]{1,2}(?:/|$))(?!.*/[.]{1,2}(?:/|$))[A-Za-z0-9._~-]{1,255}(?:/[A-Za-z0-9._~-]{1,255})*$"
      },
      "ContentSha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "ProviderToken": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?!.*[/?#])(?!.*\\\\)[!-~]+$"
      },
      "MediaType": {
        "type": "string",
        "minLength": 3,
        "maxLength": 127,
        "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
      },
      "CreateUploadRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "expected_size_bytes",
          "content_sha256",
          "declared_media_type"
        ],
        "properties": {
          "path": {
            "$ref": "#/components/schemas/LogicalPath"
          },
          "expected_size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10737418240
          },
          "content_sha256": {
            "$ref": "#/components/schemas/ContentSha256"
          },
