            "maximum": 256
          },
          "offset_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "length_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10737418240
          },
          "method": {
            "const": "PUT"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192,
            "pattern": "^https://",
            "x-sensitive": true
          },
          "headers": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/components/schemas/DirectUploadHeader"
            }
          },
          "one_use": {
            "const": true
          }
        }
      },
      "DirectUploadDescriptor": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "descriptor_id",
