{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.almira.dev/bundle.schema.json",
  "title": "Almira public contract bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "product",
    "contractVersion",
    "source",
    "bundle",
    "files"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "product": { "const": "almira" },
    "contractVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "algorithm", "digest"],
      "properties": {
        "repository": { "const": "metamorph-labs/almira-core" },
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "digest"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

