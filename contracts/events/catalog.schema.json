{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.almira.dev/events/catalog.schema.json",
  "title": "Almira public event catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "format_version",
    "events"
  ],
  "properties": {
    "schema_id": {
      "const": "almira.public.event-catalog.v1"
    },
    "format_version": {
      "const": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "x-almira-unique-by": "event_type_id",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type_id",
          "payload_schema_id",
          "payload_schema_path",
          "resource_kind",
          "data_classification",
          "lifecycle"
        ],
        "properties": {
          "event_type_id": {
            "type": "string",
            "pattern": "^almira\\.[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v1$",
            "maxLength": 128
          },
          "payload_schema_id": {
            "type": "string",
            "pattern": "^almira\\.[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v1$",
            "maxLength": 128
          },
          "payload_schema_path": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9./-]*\\.json$",
            "maxLength": 256
          },
          "resource_kind": {
            "enum": [
              "collection",
              "file",
              "generation",
              "processing_job"
            ]
          },
          "data_classification": {
            "const": "confidential"
          },
          "lifecycle": {
            "const": "active"
          }
        }
      }
    }
  }
}
