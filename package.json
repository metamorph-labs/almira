{
  "name": "almira",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.0.9"
  },
  "volta": {
    "node": "24.19.0",
    "pnpm": "11.0.9"
  },
  "scripts": {
    "build": "pnpm --filter @metamorph-labs/almira-sdk build",
    "check": "pnpm check:foundation && pnpm contracts:verify && pnpm build && pnpm test:contracts && pnpm test:sdk",
    "check:foundation": "node scripts/check-foundation.mjs",
    "contracts:accept": "node tools/contracts/bundle.mjs accept",
    "contracts:verify": "node tools/contracts/bundle.mjs verify",
    "test:contracts": "node --test tools/contracts/bundle.test.mjs",
    "test:sdk": "pnpm --filter @metamorph-labs/almira-sdk test"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
